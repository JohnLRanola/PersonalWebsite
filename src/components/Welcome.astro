</div>

<style>
	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(6px);
		transform: scale(1.05);
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		min-height: 100vh;
		display: grid;
		place-items: center;
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}

	#hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: min(1120px, 92vw);
		padding: 16px;
	}

	#hero-left {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 10px;
		text-align: left;
		color: #f7fff5;
	}

	#hero-tag {
		margin: 0;
		font-size: 0.9rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		opacity: 0.9;
	}

	#intro-name {
		margin: 0;
		font-size: clamp(2rem, 6vw, 4.2rem);
		line-height: 1.05;
		font-weight: 800;
		text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
	}

	#intro-head {
		margin: 0;
		font-size: clamp(1rem, 1.8vw, 1.2rem);
		max-width: 34ch;
		line-height: 1.45;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
	}

	#intro-subhead {
		margin: 0;
		font-size: 1rem;
		max-width: ch;
		line-height: 1.15;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
	}

	#hero-right {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		transform: translateY(-64px);
	}

	#hero-right h2 {
		margin: -260px 0 0;
	}

	#maintenance-title {
		font-family: 'Press Start 2P', ui-monospace, monospace;
		font-size: clamp(1.4rem, 3.2vw, 2.4rem);
		line-height: 1.3;
		letter-spacing: 1px;
		text-transform: uppercase;

		/* override current gradient text look */
		background: none;
		-webkit-text-fill-color: #8bff7a;
		color: #8bff7a;
		animation: none;

		/* chunky retro edge */
		text-shadow:
			2px 0 0 #111,
			0 2px 0 #111,
			2px 2px 0 #111;
	}

	#links {
		display: flex;
		gap: 16px;
		justify-content: center;
	}

	#links a {
		display: flex;
		align-items: center;
		padding: 10px 12px;
		color: #111827;
		text-decoration: none;
		transition: color 0.2s;
	}

	#links a:hover {
		color: rgb(78, 80, 86);
	}

	#links a svg {
		height: 1em;
		margin-left: 8px;
	}

	#links a.button {
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border-radius: 10px;
	}

	#links a.button:hover {
		color: rgb(230, 230, 230);
		box-shadow: none;
	}

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #f8f8f8 0%, #3bf75b 50%, #5aff4b 100%);
		background-size: 200% 200%;
		background-position: 0% 50%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
		animation: titleGradientShift 3s ease-in-out infinite;
	}

	code {
		display: inline-block;
		padding: 10px 18px;
		border-radius: 0;              
		border: 4px solid #111;
		background: #6f63ff;           
		box-shadow:
			4px 0 0 #111,
			0 4px 0 #111,
			8px 4px 0 rgba(0, 0, 0, 0.35); 
		clip-path: polygon(
			0 4px, 4px 4px, 4px 0,
			calc(100% - 4px) 0, calc(100% - 4px) 4px, 100% 4px,
			100% calc(100% - 4px), calc(100% - 4px) calc(100% - 4px), calc(100% - 4px) 100%,
			4px 100%, 4px calc(100% - 4px), 0 calc(100% - 4px)
		);
		animation: titleFloat 2.4s ease-in-out infinite;
	}

	.box {
		padding: 16px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid white;
	}

	#news {
		position: absolute;
		bottom: 16px;
		right: 16px;
		max-width: 300px;
		text-decoration: none;
		transition: background 0.2s;
		backdrop-filter: blur(50px);
	}

	#news:hover {
		background: rgba(255, 255, 255, 0.55);
	}

	@media screen and (max-height: 368px) {
		#news {
			display: none;
		}
	}

	@media screen and (max-width: 768px) {
		#hero-right {
			transform: translateY(-12px);
		}

		#hero-right h2 {
			margin: -90px 0 0;
		}

		#container {
			display: flex;
			flex-direction: column;
		}

		#hero {
			grid-template-columns: 1fr;
			padding-top: 8%;
			text-align: center;
		}

		#hero-left {
			text-align: center;
			align-items: center;
		}

		#hero-copy {
			max-width: 40ch;
		}

		#links {
			flex-wrap: wrap;
		}

		#links a.button {
			padding: 14px 18px;
		}

		#news {
			right: 16px;
			left: 16px;
			bottom: 2.5rem;
			max-width: 100%;
		}

		h1 {
			line-height: 1.5;
		}
	}

	#earth-gif {
		width: min(80vw, 600px); 
		height: auto;            
		object-fit: contain;
	}

	@media screen and (max-width: 768px) {
		#earth-gif {
			width: min(92vw, 600px);
		}
	}

@keyframes titleGradientShift {
	0% { background-position: 0% 50%; }
	50% { background-position: 100% 50%; }
	100% { background-position: 0% 50%; }
}

@keyframes titleFloat {
	0%, 100% { transform: translateY(0); }
	50% { transform: translateY(-3px); }
}

@media (prefers-reduced-motion: reduce) {
	pre,
	code {
		animation: none;
	}
}

</style>
