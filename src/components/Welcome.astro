</div>

<style>
	:global(:root) {
		--scroll-progress: 0;
	}

	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -4;
		opacity: 0.2;
		filter: blur(6px) brightness(0.4);
		transform: scale(1.05);
	}

	#space-dark {
		position: fixed;
		inset: 0;
		z-index: -3;
		background: #000;
		pointer-events: none;
		overflow: hidden;
	}

	#space-dark::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 15%, #102040 0%, #040910 48%, #000 78%);
		opacity: calc(var(--scroll-progress) * 0.92);
	}

	#stars-field {
		position: fixed;
		inset: 0;
		z-index: -2;
		pointer-events: none;
		opacity: calc(1 - (var(--scroll-progress) * 0.72));
		transform: translateY(calc(var(--scroll-progress) * 120px)) scale(calc(1 + (var(--scroll-progress) * 0.08)));
	}

	.star {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: var(--size);
		height: var(--size);
		transform: translate(-50%, -50%);
		border-radius: 999px;
		opacity: 0;
		background: radial-gradient(circle, rgba(255, 246, 194, 1) 0%, rgba(255, 228, 129, 0.9) 52%, rgba(255, 213, 99, 0.22) 78%, transparent 100%);
		filter: drop-shadow(0 0 8px rgba(255, 215, 100, 0.8));
		animation: starFlicker var(--dur) ease-in-out infinite;
		animation-delay: var(--delay);
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		min-height: 220vh;
		display: block;
	}

	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}

	#hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		width: min(1120px, 92vw);
		min-height: 100vh;
		margin: 0 auto;
		padding: 16px;
	}

	#scroll-content {
		width: min(860px, 92vw);
		margin: 0 auto;
		min-height: 95vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: flex-start;
		gap: 12px;
		color: #f7fff5;
		text-align: left;
	}

	#scroll-content h2 {
		align-self: center;
		text-align: center;
		width: 100%;
	}

	#scroll-content p {
		margin: 0;
		text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
	}

	#scroll-content h2{
		margin: 0;
		font-size: clamp(2rem, 6vw, 4.2rem);
		text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
	}

	.project-feature-left {
		width: min(920px, 92vw);
		margin-left: calc((100% - 75vw) / 2);
		margin-top: 200px;
	}

	.project-feature-right {
		margin-left: auto;
		margin-right: calc((100% - 75vw) / 2);
	}

	.project-feature-right h3 {
		text-align: right;
	}

	.project-feature-left h3 {
		margin: 0;
		font-size: clamp(1.6rem, 6.8vw, 5.2rem);
		line-height: 0.95;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		text-shadow: 0 8px 22px rgba(0, 0, 0, 0.38);
	}

	.project-feature-left p {
		margin-top: 60px;
		font-size: clamp(1.05rem, 1.9vw, 1.4rem);
		line-height: 1.35;
		max-width: none;
		text-align: justify;
		text-justify: inter-word;
	}

	.project-cta {
		display: block;
		width: fit-content;
		margin-top: 28px;
		margin-left: 0;
		padding: 2px 0;
		color: #d6f9ff;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		text-decoration: none;
		border-bottom: 2px solid rgba(182, 255, 106, 0.6);
		transition: color 0.2s ease, text-shadow 0.2s ease, border-color 0.2s ease, background-size 0.2s ease;
		background-image: linear-gradient(rgba(182, 255, 106, 0.28), rgba(182, 255, 106, 0.28));
		background-repeat: no-repeat;
		background-position: 0 100%;
		background-size: 0% 45%;
	}

	.project-cta:hover {
		color: #f3ffe8;
		text-shadow: 0 0 14px rgba(182, 255, 106, 0.65);
		border-color: rgba(206, 255, 142, 1);
		background-size: 100% 45%;
	}

	.project-cta:focus-visible {
		outline: 2px solid #b6ff6a;
		outline-offset: 3px;
	}

	#skills-section {
		width: min(860px, 84vw);
		min-height: 100vh;
		margin: 0 auto;
		padding: 96px clamp(12px, 2vw, 28px) 80px;
		color: #f7fff5;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background: transparent;
	}

	#skills-section h2 {
		margin: 0 0 26px;
		text-align: center;
		font-size: clamp(2rem, 5.4vw, 3.8rem);
		letter-spacing: 0.02em;
		text-shadow: 0 6px 20px rgba(0, 0, 0, 0.38);
	}

	.skills-grid {
		flex: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		grid-template-rows: none;
		grid-auto-rows: 148px;
		gap: 20px;
		min-height: 0;
		align-content: start;
	}

	.skill-card {
		min-height: 0;
		height: 100%;
		padding: 9px 8px 7px;
		border: 1px solid rgba(155, 235, 255, 0.24);
		border-radius: 10px;
		background: linear-gradient(165deg, rgba(8, 22, 40, 0.88), rgba(9, 27, 45, 0.72));
		backdrop-filter: blur(3px);
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.24);
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.skill-card:hover {
		transform: none;
		border-color: rgba(186, 255, 213, 0.58);
		box-shadow: 0 12px 22px rgba(0, 0, 0, 0.28);
	}

	.skill-card h3 {
		margin: 0 0 8px;
		font-size: clamp(0.86rem, 1.15vw, 1.02rem);
		line-height: 1.15;
		letter-spacing: 0.04em;
		font-weight: 800;
		text-transform: uppercase;
		color: #e7fff3;
		text-shadow: 0 0 12px rgba(158, 255, 196, 0.28);
	}

	.skill-list {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: clamp(0.82rem, 0.95vw, 0.96rem);
		line-height: 1.35;
		font-weight: 600;
		color: #f0f8ff;
		text-shadow: 0 0 8px rgba(123, 231, 255, 0.18);
	}

	.skill-list li {
		margin: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.skill-list li::before {
		content: '- ';
		color: #afffd1;
		font-weight: 800;
	}

	.highlight-skill,
	.highlight-tech,
	.highlight-platform,
	.highlight-metric {
		font-weight: 800;
	}

	.highlight-skill {
		color: #9effc4;
	}

	.highlight-tech {
		color: #7be7ff;
	}

	.highlight-platform {
		color: #ffd787;
	}

	.highlight-metric {
		color: #b6ff6a;
		letter-spacing: 0.02em;
	}

	#hero-left {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 10px;
		text-align: left;
		color: #f7fff5;
	}

	#hero-tag {
		margin: 0;
		font-size: 0.9rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		opacity: 0.9;
	}

	#intro-name {
		margin: 0;
		font-size: clamp(2rem, 6vw, 4.2rem);
		line-height: 1.05;
		font-weight: 800;
		text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
	}

	#intro-head {
		margin: 0;
		font-size: clamp(1rem, 1.8vw, 1.2rem);
		max-width: 34ch;
		line-height: 1.45;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
	}

	#intro-subhead {
		margin: 0;
		font-size: 1rem;
		max-width: 62ch;
		line-height: 1.15;
		text-align: justify;
		text-justify: inter-word;
		hyphens: auto;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
	}

	#hero-right {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		transform: translateY(-64px);
	}

	#hero-right h2 {
		margin: -260px 0 0;
	}

	#maintenance-title {
		font-family: 'Press Start 2P', ui-monospace, monospace;
		font-size: clamp(1.4rem, 3.2vw, 2.4rem);
		line-height: 1.3;
		letter-spacing: 1px;
		text-transform: uppercase;

		background: none;
		-webkit-text-fill-color: #8bff7a;
		color: #8bff7a;
		animation: none;
		text-shadow:
			2px 0 0 #111,
			0 2px 0 #111,
			2px 2px 0 #111;
	}

	#links {
		display: flex;
		gap: 16px;
		justify-content: center;
	}

	#links a {
		display: flex;
		align-items: center;
		padding: 10px 12px;
		color: #111827;
		text-decoration: none;
		transition: color 0.2s;
	}

	#links a:hover {
		color: rgb(78, 80, 86);
	}

	#links a svg {
		height: 1em;
		margin-left: 8px;
	}

	#links a.button {
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border-radius: 10px;
	}

	#links a.button:hover {
		color: rgb(230, 230, 230);
		box-shadow: none;
	}

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #f8f8f8 0%, #3bf75b 50%, #5aff4b 100%);
		background-size: 200% 200%;
		background-position: 0% 50%;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
		animation: titleGradientShift 3s ease-in-out infinite;
	}

	code {
		display: inline-block;
		padding: 10px 18px;
		border-radius: 0;              
		border: 4px solid #111;
		background: #6f63ff;           
		box-shadow:
			4px 0 0 #111,
			0 4px 0 #111,
			8px 4px 0 rgba(0, 0, 0, 0.35); 
		clip-path: polygon(
			0 4px, 4px 4px, 4px 0,
			calc(100% - 4px) 0, calc(100% - 4px) 4px, 100% 4px,
			100% calc(100% - 4px), calc(100% - 4px) calc(100% - 4px), calc(100% - 4px) 100%,
			4px 100%, 4px calc(100% - 4px), 0 calc(100% - 4px)
		);
		animation: titleFloat 2.4s ease-in-out infinite;
	}

	.box {
		padding: 16px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid white;
	}

	#news {
		position: absolute;
		bottom: 16px;
		right: 16px;
		max-width: 300px;
		text-decoration: none;
		transition: background 0.2s;
		backdrop-filter: blur(50px);
	}

	#news:hover {
		background: rgba(255, 255, 255, 0.55);
	}

	@media screen and (max-height: 368px) {
		#news {
			display: none;
		}
	}

	@media screen and (max-width: 768px) {
		#scroll-content {
			align-items: flex-start;
			text-align: left;
		}

		.project-feature-left {
			margin-left: 0;
			width: 100%;
		}

		.project-feature-right {
			margin-right: 0;
		}

		#hero-right {
			transform: translateY(-12px);
		}

		#hero-right h2 {
			margin: -90px 0 0;
		}

		#container {
			display: flex;
			flex-direction: column;
		}

		#hero {
			grid-template-columns: 1fr;
			padding-top: 8%;
			text-align: center;
		}

		#scroll-content {
			min-height: 80vh;
		}

		#skills-section {
			min-height: 100vh;
			padding: 80px 0;
		}

		.skills-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: none;
			grid-auto-rows: 138px;
			flex: 0;
			min-height: 0;
		}

		.skill-card {
			height: 100%;
			min-height: 0;
			padding: 6px 8px;
		}

		#hero-left {
			text-align: center;
			align-items: center;
		}

		#hero-copy {
			max-width: 40ch;
		}

		#links {
			flex-wrap: wrap;
		}

		#links a.button {
			padding: 14px 18px;
		}

		#news {
			right: 16px;
			left: 16px;
			bottom: 2.5rem;
			max-width: 100%;
		}

		h1 {
			line-height: 1.5;
		}
	}

	@media screen and (max-width: 520px) {
		.skills-grid {
			grid-template-columns: 1fr;
			grid-auto-rows: 130px;
		}

		.skill-card {
			min-height: 130px;
		}
	}

	#earth-gif {
		width: min(80vw, 600px); 
		height: auto;            
		object-fit: contain;
	}

	@media screen and (max-width: 768px) {
		#earth-gif {
			width: min(92vw, 600px);
		}
	}

@keyframes titleGradientShift {
	0% { background-position: 0% 50%; }
	50% { background-position: 100% 50%; }
	100% { background-position: 0% 50%; }
}

@keyframes starFlicker {
	0%, 100% {
		opacity: 0;
	}
	20% {
		opacity: var(--alpha);
	}
	58% {
		opacity: var(--alpha);
	}
	82% {
		opacity: 0.24;
	}
	92% {
		opacity: 0.08;
	}
}

@keyframes titleFloat {
	0%, 100% { transform: translateY(0); }
	50% { transform: translateY(-3px); }
}

@media (prefers-reduced-motion: reduce) {
	pre,
	code {
		animation: none;
	}

	#stars-field,
	.star {
		animation: none;
	}

	#stars-field {
		transform: none;
	}
}

</style>

<script is:inline>
	const updateScrollBackground = () => {
		const scrollMax = document.documentElement.scrollHeight - window.innerHeight;
		const progress = scrollMax > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollMax)) : 0;
		document.documentElement.style.setProperty('--scroll-progress', progress.toFixed(4));
	};

	updateScrollBackground();
	window.addEventListener('scroll', updateScrollBackground, { passive: true });
	window.addEventListener('resize', updateScrollBackground);
</script>
