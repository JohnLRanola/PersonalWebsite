	<img id="background" src={maintenanceBG.src} alt="" fetchpriority="high" />

	<section id="hero">
		<div id="hero-left">
			<p id="hero-tag">DistantPluto</p>
			<h1 id="intro-name">John Ranola</h1>
			<p id="intro-head">Creative Developer | Web Development, Software & 3D Design</p>
			<p id="intro-subhead">
				Creativity and Technology. Two things I love combining to create interactive digital experiences, websites, and software.
				As a Computer Science Graduate that's skilled in web development, software development, and 3D design, I enjoy building digital experiences that are both functional and visually appealing.
			</p>
		</div>

		<div id="hero-right">
			<img id="earth-gif" src={earthRotate.src} width="600" height="550" alt="Earth Rotate" />
			<h2>
				<code><pre id="maintenance-title">Under Maintenance</pre></code>
			</h2>
		</div>
	</section>

