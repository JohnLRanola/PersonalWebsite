---
import earthRotate from '../assets/earthRotate.gif';
import '../styles/welcome.css';

const stars = Array.from({ length: 55 }, () => ({
	x: (Math.random() * 100).toFixed(2),
	y: (Math.random() * 100).toFixed(2),
	size: (3.4 + Math.random() * 4.2).toFixed(2),
	duration: (2.8 + Math.random() * 4).toFixed(2),
	delay: (-Math.random() * 6).toFixed(2),
	alpha: (0.62 + Math.random() * 0.38).toFixed(2)
}));
---

<div id="container">
	<div id="space-dark" aria-hidden="true"></div>
	<div id="stars-field" aria-hidden="true">
		{stars.map((star) => (
			<span
				class="star"
				style={`--x: ${star.x}%; --y: ${star.y}%; --size: ${star.size}px; --dur: ${star.duration}s; --delay: ${star.delay}s; --alpha: ${star.alpha};`}
			></span>
		))}
	</div>

	<header id="site-header" aria-label="Site header">
		<p class="site-brand">DistantPluto</p>
		<nav aria-label="Primary navigation">
			<a href="#hero">Home</a>
			<a href="#scroll-content">Projects</a>
			<a href="#skills-section">Skills</a>
		</nav>
	</header>

	<section id="hero">
		<div id="hero-left">
			<p id="hero-tag">DistantPluto</p>
			<h1 id="intro-name">John Ranola</h1>
			<p id="intro-head">Creative Developer | Web Development, Software & 3D Design</p>
			<p id="intro-subhead">
				Creativity and Technology. Two things I love combining to create interactive digital experiences, websites, and software.
				As a Computer Science Graduate that's skilled in web development, software development, and 3D design, I enjoy building digital experiences that are both functional and visually appealing.
			</p>
		</div>

		<div id="hero-right">
			<img id="earth-gif" src={earthRotate.src} width="600" height="550" alt="Earth Rotate" />
			<h2>
				<code><pre id="maintenance-title">Under Maintenance</pre></code>
			</h2>
		</div>
	</section>

	<section id="scroll-content" aria-label="Scroll content">
		<h2>PROJECTS</h2>
		<article class="project-feature-left">
			<h3>PROJECT LILYPAD</h3>
			<p>
				<br />
				I wanted a challenge that would push me to <span class="highlight-skill">design and develop a game</span>. So I did! I decided to make a game in <span class="highlight-tech">Unreal Engine 5</span> within <span class="highlight-metric">30 days</span> and to make it harder, I decided to make it a <span class="highlight-skill">community-driven game</span>,
				using ideas and feedback gathered from <span class="highlight-platform">YouTube and TikTok comments</span>. 
				<br />
				The development series generated approximately <span class="highlight-metric">100,000 views</span> across social media and provided valuable experience 
				in <span class="highlight-skill">rapid game development</span>, <span class="highlight-skill">community-driven design</span>, and <span class="highlight-tech">Unreal Engine 5</span>.

			</p>
			<a class="project-cta" href="/projects/lilypad" aria-label="View Project Lilypad case study page">
				CLICK HERE TO CHECK OUT PROJECT LILYPAD
			</a>
		</article>

		<article class="project-feature-left project-feature-right">
			<h3>ANIMATIONS</h3>
			<p>
				<br />
				These are a few of my <span class="highlight-skill">3D animations</span> that I created using <span class="highlight-tech">Blender</span>. 
				I love making these as they allow me to just be goofy and express my love for animation.
				<br />
				These are inspired by games like <span class="highlight-platform">Animal Crossing</span> and <span class="highlight-platform">Tomodachi Life</span>, 
				as well as my love for <span class="highlight-platform">Anime</span> especially <span class="highlight-platform">Studio Ghibli</span>.

			</p>
			<a class="project-cta" href="/projects/your-project" aria-label="View project details page">
				CLICK HERE TO CHECK OUT ANIMATIONS
			</a>
		</article>

		
	</section>

	<section id="skills-section" aria-label="Technical skills">
		<h2>CREATIVE & TECHNICAL TOOLKIT</h2>
		<div class="skills-grid">
			<article class="skill-card">
				<h3>Programming Languages</h3>
				<ul class="skill-list">
					<li>JavaScript</li>
					<li>C</li>
					<li>Python</li>
					<li>Java</li>
					<li>R</li>
				</ul>
			</article>
			<article class="skill-card">
				<h3>Web Development</h3>
				<ul class="skill-list">
					<li>React</li>
					<li>PHP</li>
					<li>HTML</li>
					<li>CSS</li>
					<li>Node.js</li>
				</ul>
			</article>
			<article class="skill-card">
				<h3>Databases</h3>
				<ul class="skill-list">
					<li>SQL</li>
					<li>MySQL</li>
					<li>PostgreSQL</li>
				</ul>
			</article>
			<article class="skill-card">
				<h3>3D and Design</h3>
				<ul class="skill-list">
					<li>Blender</li>
				</ul>
			</article>
			<article class="skill-card">
				<h3>Creative Software</h3>
				<ul class="skill-list">
					<li>Adobe Photoshop</li>
					<li>Krita</li>
					<li>After Effects</li>
					<li>Premiere Pro</li>
					<li>Ableton</li>
				</ul>
			</article>
			<article class="skill-card">
				<h3>Development Tools</h3>
				<ul class="skill-list">
					<li>Git</li>
					<li>GitHub</li>
					<li>VS Code</li>
					<li>Jupyter Notebook</li>
				</ul>
			</article>
			<article class="skill-card">
				<h3>Game Development</h3>
				<ul class="skill-list">
					<li>Unreal Engine 5</li>
					<li>Gameplay Prototyping</li>
					<li>Iteration Workflows</li>
					<li>Behaviour Trees</li>
				</ul>
			</article>
			<article class="skill-card">
				<h3>Content and Storytelling</h3>
				<ul class="skill-list">
					<li>Short-form Content Strategy</li>
					<li>Audience-centered Presentation</li>
				</ul>
			</article>
			<article class="skill-card">
				<h3>Team Collaboration</h3>
				<ul class="skill-list">
					<li>Version Control Workflows</li>
					<li>Feedback Loops</li>
					<li>Communication</li>
				</ul>
			</article>
		</div>
	</section>

	<footer id="site-footer" aria-label="Site footer">
		<p>© 2026 DISTANTPLUTO</p>
		<nav aria-label="Footer links">
			<a href="#hero">Back to Top</a>
			<a href="#scroll-content">Projects</a>
			<a href="#skills-section">Skills</a>
		</nav>
	</footer>

