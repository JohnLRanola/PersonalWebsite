---
import distantPlutoIcon from "../assets/distantplutoicon.png";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/png" href={distantPlutoIcon.src} />
		<link rel="shortcut icon" type="image/png" href={distantPlutoIcon.src} />
		<meta name="generator" content={Astro.generator} />
		<title>DistantPluto</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	* {
		box-sizing: border-box;
	}
</style>
